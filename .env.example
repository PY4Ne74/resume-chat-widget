# Copy this file's contents into Vercel's Environment Variables UI (Project Settings > Environment Variables).
# Do NOT commit a real .env file with actual secrets.

# Your Anthropic API key (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to use. Sonnet 5 for quality; swap to a Haiku model if you want lower cost at higher volume.
ANTHROPIC_MODEL=claude-sonnet-5

# The exact origin of your live WordPress site, e.g. https://robertlamb.com
# Using * works for testing but should be locked down to your real domain before going live.
ALLOWED_ORIGIN=*
